# Server-owned secrets, never commit .env. Generate passwords with openssl rand -hex 24.
GSLT=
RCON_PASSWORD=
SERVER_PASSWORD=
BRIDGE_TOKEN=
# The server Docker target fetches the pinned map-v1 VPKs. No Workshop ID supplied.
MAP=df_spaceport_player_scale_raytrace
PORT=27015
INSTALL_ON_START=0
UPDATE_ON_START=0
VALIDATE=0
SERVER_ID=raid-friends
SSG_API_ORIGIN=https://your-ssg-origin.example
SSG_CLIENT_ID=
SSG_APP_SECRET=
